<resources>
    <!-- 应用内实际主题;配色由 Compose(GoClawTheme)接管。 -->
    <style name="Theme.GoClawChat" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      启动主题:固定浅色背景(splash_bg = 内容浅色背景色)的 SplashScreen。
      启动窗口即以此背景绘制,内容首帧(runBlocking 已取到正确主题)绘制完成后自动淡出并
      切到 Theme.GoClawChat,从而消除「启动窗口色 ≠ 内容色」造成的黑白闪烁。
    -->
    <style name="Theme.GoClawChat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.GoClawChat</item>
    </style>
</resources>
